{
	"name": "csindiatests",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:search": "node scripts/build-search-index.js",
		"dev": "pnpm run build:search && vite dev",
		"build": "pnpm run build:search && vite build",
		"preview": "vite preview",
		"prepare": "pnpm run build:search && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.35.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/katex": "^0.16.7",
		"@types/marked": "^5.0.2",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"dexie": "^4.4.5",
		"katex": "^0.16.11",
		"marked": "^15.0.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.5.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"minisearch": "^7.2.0"
	}
}
